{
  "editor.fontFamily": "'Iosevka Nerd Font Mono', monospace",
  "terminal.integrated.fontFamily": "'Iosevka Nerd Font Mono'",
  "editor.fontLigatures": true,
  "editor.fontSize": 15,
  "editor.lineHeight": 1.5,

  // --- Remove Rulers & Clean UI ---
  "editor.rulers": [],
  "workbench.colorTheme": "Default Dark Modern",
  "workbench.activityBar.location": "hidden",
  "workbench.statusBar.visible": true,
  "editor.renderWhitespace": "none",
  "editor.hideCursorInOverviewRuler": true,
  "editor.overviewRulerBorder": false,
  "window.commandCenter": false,
  "window.menuBarVisibility": "toggle",
  "breadcrumbs.enabled": false,

  // --- Vim basics ---
  "vim.leader": "<space>",
  "vim.useSystemClipboard": true,
  "vim.hlsearch": true,
  "vim.incsearch": true,
  "vim.easymotion": true,
  "vim.timeout": 300,
  "vim.smartRelativeLine": true,

  // jj to escape
  "vim.insertModeKeyBindingsNonRecursive": [
    {
      "before": [
        "j",
        "j"
      ],
      "after": [
        "<Esc>"
      ]
    }
  ],

  // Normal mode shortcuts
  "vim.normalModeKeyBindingsNonRecursive": [
    // Save / close
    {
      "before": [
        "<leader>",
        "w"
      ],
      "commands": [
        "workbench.action.files.save"
      ]
    },
    {
      "before": [
        "<leader>",
        "q"
      ],
      "commands": [
        "workbench.action.closeActiveEditor"
      ]
    },
    // Find things
    {
      "before": [
        "<leader>",
        "f"
      ],
      "commands": [
        "workbench.action.quickOpen"
      ]
    },
    {
      "before": [
        "<leader>",
        "g"
      ],
      "commands": [
        "workbench.action.findInFiles"
      ]
    },
    {
      "before": [
        "<leader>",
        "p"
      ],
      "commands": [
        "workbench.action.showCommands"
      ]
    },
    // Toggle sidebar / terminal
    {
      "before": [
        "<leader>",
        "e"
      ],
      "commands": [
        "workbench.action.toggleSidebarVisibility"
      ]
    },
    {
      "before": [
        "<leader>",
        "t"
      ],
      "commands": [
        "workbench.action.terminal.toggleTerminal"
      ]
    },
    // Code actions
    {
      "before": [
        "<leader>",
        "r"
      ],
      "commands": [
        "editor.action.rename"
      ]
    },
    {
      "before": [
        "<leader>",
        "a"
      ],
      "commands": [
        "editor.action.quickFix"
      ]
    },
    {
      "before": [
        "g",
        "r"
      ],
      "commands": [
        "editor.action.goToReferences"
      ]
    },
    // Faster line movement
    {
      "before": [
        "H"
      ],
      "after": [
        "^"
      ]
    },
    {
      "before": [
        "L"
      ],
      "after": [
        "$"
      ]
    },
    // Clear search highlight
    {
      "before": [
        "<leader>",
        "h"
      ],
      "commands": [
        ":nohl"
      ]
    }
  ],

  // Visual mode: keep selection when indenting
  "vim.visualModeKeyBindingsNonRecursive": [
    {
      "before": [
        ">"
      ],
      "commands": [
        "editor.action.indentLines"
      ]
    },
    {
      "before": [
        "<"
      ],
      "commands": [
        "editor.action.outdentLines"
      ]
    }
  ],

  // Smooth and fast editor
  "editor.minimap.enabled": false,
  "editor.lineNumbers": "relative",
  "editor.cursorBlinking": "smooth",
  "editor.formatOnSave": true,
  "editor.stickyScroll.enabled": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "files.autoSave": "onFocusChange",
  "workbench.editor.enablePreview": false,
  "workbench.list.smoothScrolling": true,
  "terminal.integrated.smoothScrolling": true,
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
    "java": false
  },
  "chat.experimental.incrementalRendering.enabled": true,
  "editor.smoothScrolling": true
}
