# ~/.gitconfig
# Clean, simple, no-surprises git setup (Neovim + zsh)

[user]
	name = thatsothoun
	email = thatsothounctrl01@gmail.com

[init]
	defaultBranch = main

[core]
	editor = nvim
	pager = less -FRX
	autocrlf = input
	whitespace = trailing-space,space-before-tab

[color]
	ui = auto

[status]
	short = true
	branch = true

[column]
	ui = auto

[branch]
	sort = -committerdate

[push]
	default = simple
	autoSetupRemote = true
	followTags = true

[pull]
	rebase = true

[fetch]
	prune = true

[rebase]
	autoStash = true
	autoSquash = true

[merge]
	conflictStyle = zdiff3

[rerere]
	enabled = true

[diff]
	algorithm = histogram
	colorMoved = default

[help]
	autocorrect = prompt

# Uncomment if you use GitHub CLI for auth:
# [credential "https://github.com"]
# 	helper = !gh auth git-credential

[alias]
	st = status
	co = checkout
	sw = switch
	br = branch
	cm = commit -m
	ca = commit --amend --no-edit
	aa = add -A
	d = diff
	ds = diff --staged
	undo = reset --soft HEAD~1
	unstage = restore --staged
	last = log -1 --stat
	lg = log --oneline --graph --decorate -20
	lga = log --oneline --graph --decorate --all
	cleanup = "!git branch --merged | grep -v '\\*\\|main\\|master' | xargs -r git branch -d"
